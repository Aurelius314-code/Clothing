{
  "meta": {
    "version": "0.2.1",
    "description": "Klassisk britisk vintage herremote - merker, nøkkelord og måleregler for Vintage Wardrobe Watcher",
    "focus": "Naturfiber, eldre britisk håndverk (før ca. 2000), egnet for kaldt klima",
    "units": "cm",
    "unit_note": "Mål oppgitt i tommer konverteres til cm (x 2,54) før lagring og sammenligning.",
    "tier_legend": {
      "A": "Toppnivå - mest ekstra poeng",
      "B": "Solid - litt ekstra poeng"
    },
    "field_legend": {
      "names": "Første navn er visningsnavn, resten er alias og feilstavinger. Matches etter normalisering.",
      "models": "Modellnavn som bare teller når merket også er funnet i annonsen.",
      "require_any": "Merket teller bare hvis minst ett av ordene også står i annonsen.",
      "boost_if_any": "Ekstra poeng hvis ett av ordene står i annonsen.",
      "negative_models": "Modeller fra merket som gir minuspoeng.",
      "era_markers": "Tegn som tidfester plagget.",
      "retailer": "Forhandler eller rebrand - kvaliteten avhenger av hvem som faktisk laget plagget.",
      "suggested": "Lagt til som forslag, sto ikke på den opprinnelige lista - vurder.",
      "origin": "Landkode for merket."
    },
    "keyword_policy": "positive_keywords gir pluss, negative_keywords gir minus. Harde stopp skjer bare via excluded_brands.hard, matching.counterfeit_words og material_rules.",
    "moved_out": "Lokasjoner, VOEC-grense og tollsatser er flyttet ut av denne fila - de hører hjemme i søke- og priskonfigurasjonen."
  },

  "matching": {
    "normalize": {
      "lowercase": true,
      "ampersand_to_and": true,
      "strip_punctuation": true,
      "strip_diacritics": true,
      "collapse_whitespace": true
    },
    "word_boundaries": true,
    "negation_words": ["no", "not", "non", "without", "free of", "zero", "ingen", "inga", "inte", "utan", "fri från"],
    "negation_window_words": 3,
    "style_patterns": [
      "{brand} style",
      "{brand} type",
      "{brand} look",
      "{brand} inspired",
      "not {brand}",
      "similar to {brand}",
      "like {brand}",
      "a la {brand}",
      "{brand} stil",
      "i stil med {brand}",
      "liknande {brand}"
    ],
    "style_patterns_note": "Mønstrene sjekkes rundt merkenavnet, ikke som løse ord - ellers treffer «like» også «like new».",
    "counterfeit_words": ["replica", "fake", "copy", "imitation", "kopia"],
    "brand_field_first": "Bruk eBays Brand-felt (localizedAspects) når det finnes, og tittelen som reserve.",
    "origin_signals": {
      "boost": ["made in England", "made in Scotland", "made in Great Britain", "made in UK", "made in Wales", "made in Ireland", "made in Northampton", "tillverkad i England", "tillverkad i Skottland"],
      "penalty": ["made in China", "made in Bangladesh", "made in Cambodia"]
    },
    "unit_ranges": {
      "note": "Bryst og liv kan være oppgitt flatt eller som omkrets. Verdier i overlappssonen krever enhetsmarkør eller et annet mål å sjekke mot.",
      "pit_to_pit": {
        "flat_in": [18, 28],
        "flat_cm": [46, 72],
        "circumference_in": [34, 56],
        "circumference_cm": [86, 142],
        "ambiguous": [46, 56]
      },
      "waist": {
        "flat_in": [14, 24],
        "flat_cm": [36, 61],
        "circumference_in": [28, 48],
        "circumference_cm": [71, 122],
        "ambiguous": [36, 48]
      },
      "label_sizes": "Jakkestørrelser som 40R, 42L og 44S er brystomkrets i tommer."
    }
  },

