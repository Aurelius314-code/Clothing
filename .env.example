EBAY_CLIENT_ID=your_client_id
EBAY_CLIENT_SECRET=your_client_secret
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_SHIP_TO_COUNTRY=NO
# Optional: Tradera (Sweden). Free developer account and app at https://api.tradera.com/register
TRADERA_APP_ID=
TRADERA_APP_KEY=
# Optional: you can receive parcels at an address or pickup point in Sweden. Adds an eBay search for
# sellers who ship to Sweden (on EBAY_SWEDEN_MARKETPLACE_ID, default eBay Germany), and Swedish shipping on Tradera.
# SWEDISH_PICKUP=1
# EBAY_SWEDEN_MARKETPLACE_ID=EBAY_DE
DEEPSEEK_API_KEY=your_deepseek_key
# Optional: another DeepSeek model that accepts images
# DEEPSEEK_MODEL=deepseek-flash
# Optional: drop photo readings unless DeepSeek says both tape ends and the scale are clearly visible.
# Without it, such readings are kept but marked uncertain.
# STRICT_PHOTO_EVIDENCE=1
